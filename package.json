{
  "name": "playwright-automation-practice",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) E2E + API automation for ExpandTesting and Blogspot practice sites",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:parallel": "playwright test --workers=4",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test --project=api",
    "test:expand": "playwright test --project=chromium --grep @expand --workers=1",
    "test:expand:api": "playwright test tests/api/expand-api.spec.js --project=api",
    "cucumber": "cucumber-js",
    "cucumber:headed": "HEADED=true SLOW_MO=100 cucumber-js --parallel 1",
    "cucumber:journey": "HEADED=true SLOW_MO=100 cucumber-js --tags '@journey' --parallel 1",
    "cucumber:api": "cucumber-js --tags '@api' --parallel 1",
    "cucumber:smoke": "cucumber-js --tags '@smoke' --parallel 1",
    "cucumber:ui:headed": "HEADED=true SLOW_MO=100 cucumber-js --tags 'not @api' --parallel 1",
    "cucumber:expand": "BASE_URL=https://practice.expandtesting.com SUT=expand cucumber-js --tags '@expand' --parallel 1",
    "cucumber:expand:headed": "HEADED=true SLOW_MO=80 BASE_URL=https://practice.expandtesting.com SUT=expand cucumber-js --tags '@expand and not @catalog' --parallel 1",
    "cucumber:expand:core": "BASE_URL=https://practice.expandtesting.com SUT=expand cucumber-js --tags '@expand and @smoke' --parallel 1",
    "cucumber:expand:catalog": "BASE_URL=https://practice.expandtesting.com SUT=expand cucumber-js --tags '@expand and @catalog' --parallel 1",
    "cucumber:expand:api": "BASE_URL=https://practice.expandtesting.com SUT=expand cucumber-js --tags '@expand and @api' --parallel 1",
    "report": "playwright show-report",
    "report:generate": "node scripts/generate-overall-report.js",
    "report:merge": "node scripts/generate-overall-report.js --merge-cucumber",
    "report:all": "node scripts/run-all-with-report.js",
    "report:expand": "node scripts/run-expand-with-report.js",
    "report:open": "open test-results/index.html",
    "report:cucumber": "open test-results/cucumber-report.html",
    "codegen": "playwright codegen https://practice.expandtesting.com/",
    "trace:show": "playwright show-trace"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arunmuchalambi/PlaywrightAutomation.git"
  },
  "keywords": [
    "playwright",
    "javascript",
    "e2e",
    "automation",
    "qa"
  ],
  "author": "Arun",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.40.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.3.1"
  }
}
